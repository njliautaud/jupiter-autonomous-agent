# config/agent.env — copied to $AGENT_HOME/config/agent.env by install.sh (chmod 600).
# PLACEHOLDERS ONLY in this example. Real values live only in your installed copy,
# which is git-ignored. Never commit it, never paste it into a chat or an issue.

# --- identity ------------------------------------------------------------------
AGENT_NAME=assistant          # shows up as the author on the memory feed
OWNER_NAME=the owner          # how the agent refers to you in summaries

# --- network (VPN/tailnet ONLY — never bind a public interface) -----------------
# The address phone-facing services bind to. 127.0.0.1 = this machine only.
# To use from your phone, set it to this machine's VPN/tailnet address, e.g. <HOST_IP>.
BIND_ADDR=127.0.0.1

# --- shared memory bus ----------------------------------------------------------
MEM_ENABLE=1
MEM_BIND=127.0.0.1            # set to <HOST_IP> so other machines' agents can reach it
MEM_PORT=7692
MEM_TOKEN=                    # generated by install.sh; remote agents send it as a Bearer token

# --- usage tier -----------------------------------------------------------------
USAGE_5H_YELLOW=60
USAGE_5H_RED=85
USAGE_7D_YELLOW=70
USAGE_7D_RED=90
USAGE_PACE_YELLOW=10
USAGE_CTX_NAG_TOKENS=200000
# Colon-separated dirs exempt from the RED subagent block (time-critical bots).
USAGE_PROTECTED_DIRS=

# --- always-on services (always-on/start.sh) -------------------------------------
AGENT_ENABLE=1
TTYD_ENABLE=0
TTYD_PORT=7681
TTYD_CREDENTIAL=              # user:password for the web terminal (generated by install.sh)
TLS_ENABLE=0
TLS_PORT=7683
RC_ENABLE=0                   # Claude Code Remote Control server
RC_NAME=assistant
RC_CAPACITY=4
RC_PERMISSION_MODE=default
DESKTOP_ENABLE=0              # virtual desktop (run always-on/setup_desktop.sh first)
DISPLAY_NUM=99
VNC_PORT=5901
NOVNC_PORT=7682
VNC_PASSWORD=
NOVNC_URL=                    # e.g. https://<HOST_IP>:7682/vnc.html?autoconnect=1&resize=scale

# --- phone alerts (bin/notify) ------------------------------------------------------
NOTIFY_WEBHOOK_URL=           # a PRIVATE channel webhook, e.g. a Discord channel webhook
NOTIFY_WEBHOOK_FIELD=content  # "text" for Slack-style webhooks
NOTIFY_MIN_INTERVAL=600       # seconds between messages on the same topic

# --- script-first pulse (bin/pulse_precheck.py) -------------------------------------
PULSE_URLS=https://example.com
PULSE_DISK_PATHS=/
PULSE_DISK_WARN=90
PULSE_INBOX_CMD=              # command printing one integer, e.g. an unread-mail counter
PULSE_HEARTBEAT_H=24
PULSE_MAX_TURNS=15
PULSE_TIMEOUT_S=60
